<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/Broiler.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.DateTime</PackageProjectUrl>
    <PackageTags>broiler;datetime;iso8601;rfc3339;calendar</PackageTags>
    <Description>Extended-range ISO-8601 / RFC-3339 date-time value library for Broiler.</Description>
  </PropertyGroup>
</Project>
